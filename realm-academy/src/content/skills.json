  "bosses": [
    { "id": "boss.math.ratio", "realm": "math", "name": "The Ratio Golem", "icon": "🗿", "skills": ["math.ratios"], "taunt": "Your recipes will always be LUMPY! Three parts chaos to two parts doom!", "defeatLine": "Perfectly… proportioned… defeat…" },
    { "id": "boss.math.percent", "realm": "math", "name": "The Percent Phantom", "icon": "👻", "skills": ["math.percent"], "taunt": "I'll take 100% of your courage and leave you 0% hope!", "defeatLine": "I feel… 25% smaller… per hit…" },
    { "id": "boss.math.decimals", "realm": "math", "name": "The Decimal Wraith", "icon": "🌫️", "skills": ["math.decimals"], "taunt": "One slipped decimal point and your whole tower crumbles!", "defeatLine": "Off… by a factor… of ten…" },
    { "id": "boss.math.stats", "realm": "math", "name": "The Data Dragon", "icon": "🐉", "skills": ["math.stats"], "taunt": "Your average will never measure up to ME!", "defeatLine": "Statistically… improbable…" },
    { "id": "boss.math.probability", "realm": "math", "name": "The Chance Chimera", "icon": "🦁", "skills": ["math.probability"], "taunt": "The odds of beating me? Zero point ZERO!", "defeatLine": "I should have… calculated… the complement…" },
    { "id": "boss.math.geometry", "realm": "math", "name": "The Shape Shifter", "icon": "🔷", "skills": ["math.geometry"], "taunt": "You can't measure what you can't pin down!", "defeatLine": "My area… decomposed…" },
    { "id": "boss.math.inequalities", "realm": "math", "name": "The Lopsided King", "icon": "👑", "skills": ["math.inequalities"], "taunt": "Nothing about this fight will be EQUAL!", "defeatLine": "x was less than… I hoped…" },
    { "id": "boss.math.twovar", "realm": "math", "name": "The Graph Gryphon", "icon": "🦅", "skills": ["math.twovar"], "taunt": "As my power rises, your hopes fall — THAT'S a relationship!", "defeatLine": "My slope… is going… down…" },
    { "id": "boss.science.ecology", "realm": "science", "name": "The Smog Serpent", "icon": "🐍", "skills": ["science.ecology"], "taunt": "I'll tangle every food web on this island!", "defeatLine": "The energy… flows… without me…" },
    { "id": "boss.science.waves", "realm": "science", "name": "The Echo Wraith", "icon": "🔊", "skills": ["science.waves"], "taunt": "Your answers are just noise, noise, NOISE!", "defeatLine": "My amplitude… fading…" },
    { "id": "boss.science.water", "realm": "science", "name": "The Drought Djinn", "icon": "🏜️", "skills": ["science.water"], "taunt": "I'll evaporate every drop of your confidence!", "defeatLine": "The cycle… always… wins…" },
    { "id": "boss.english.grammar", "realm": "english", "name": "The Run-On Beast", "icon": "🦛", "skills": ["english.grammar", "english.writing"], "taunt": "I never stop I never pause I just keep going and going and!", "defeatLine": "Finally. A full stop." },
    { "id": "boss.english.sphinx", "realm": "english", "name": "The Riddling Sphinx", "icon": "🦁", "skills": ["english.vocab", "english.literary", "english.reading"], "taunt": "Answer my riddles or remain UNREAD forever!", "defeatLine": "A reader… worthy of the Stacks…" },
    { "id": "boss.french.douanier", "realm": "french", "name": "Le Douanier Grincheux", "icon": "🛃", "skills": ["french.greetings", "french.numbers", "french.calendar"], "taunt": "Personne n'entre sans parler français! Nobody enters!", "defeatLine": "Bienvenue… you have earned the harbor…" },
    { "id": "boss.french.chef", "realm": "french", "name": "Le Chef Fantôme", "icon": "👨‍🍳", "skills": ["french.family", "french.school", "french.colors", "french.food"], "taunt": "You cannot order even a croissant! Quelle horreur!", "defeatLine": "Magnifique… the café is yours…" },
    { "id": "boss.french.horloger", "realm": "french", "name": "L'Horloger Maudit", "icon": "⏰", "skills": ["french.hobbies", "french.time", "french.house"], "taunt": "Tick tock! You'll never tell MY time!", "defeatLine": "Il est l'heure… de partir…" },
    { "id": "boss.hum.sultan", "realm": "humanities", "name": "The Sandstorm Sultan", "icon": "🌪️", "skills": ["hum.mali", "hum.india", "hum.china"], "taunt": "I'll bury every trade route in sand and silence!", "defeatLine": "The caravans… remember…" },
    { "id": "boss.hum.fog", "realm": "humanities", "name": "The Fog of Ages", "icon": "🌁", "skills": ["hum.medieval", "hum.renaissance", "hum.exploration"], "taunt": "History fades! Names blur! Dates dissolve in my mist!", "defeatLine": "You… remembered… everything…" }
  ]
